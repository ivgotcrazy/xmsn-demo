# 需脉枢纽后端环境变量（复制为 .env 后填写密钥；config.py 从 backend/ 目录读取）
# 数据库/向量库默认连接本机 docker-compose（无需改）；大模型与 Embedding Key 必须配置。

# ---- 大模型（厂商解析/对话/匹配；主力 DeepSeek，OpenAI 兼容 SDK）----
# deepseek_api_key=sk-xxx
# deepseek_base_url=https://api.deepseek.com
# deepseek_model=deepseek-chat

# ---- Embedding（智谱 embedding-2，1024 维；T2.4 双轨向量化）----
# embedding_api_key=xxx.xxx
# embedding_base_url=https://open.bigmodel.cn/api/paas/v4
# embedding_model=embedding-2

# ---- 可选：调整业务常量 ----
# llm_temperature=0.2
# llm_retry=2
# verify_code_required=false
